// SYON grammar for pest (PEG)
//
// Spacing rule: `:`, `-`, `#` are structural ONLY when followed by ASCII
// space or newline (or at end-of-input). Otherwise they are literal content.

// ---------------------------------------------------------------------------
// Whitespace / primitives
// ---------------------------------------------------------------------------

NEWLINE = _{ "\r\n" | "\n" }
SP      = _{ " " }
// Horizontal whitespace (spaces only — tabs in indent are forbidden)
hspace  = _{ " " }
// Any character that is not a newline
not_nl  = _{ !NEWLINE ~ ANY }

// Indentation: zero or more spaces at column 0
indent = { " "* }

// A single blank line (whitespace only)
blank_line = _{ " "* ~ NEWLINE }

// ---------------------------------------------------------------------------
// Forbidden construct detection
// (These rules are used in error-reporting; the parser rejects them.)
// ---------------------------------------------------------------------------

forbidden_tag        = { ("!!" | "!") ~ ASCII_ALPHANUMERIC+ }
forbidden_anchor     = { "&" ~ ASCII_ALPHANUMERIC+ }
forbidden_alias      = { "*" ~ ASCII_ALPHANUMERIC+ }
forbidden_doc_start  = { "---" ~ (SP | NEWLINE | EOI) }
forbidden_complex_key = { "?" ~ (SP | NEWLINE | EOI) }
forbidden_flow_open  = { "{" | "[" }

// ---------------------------------------------------------------------------
// Keys
// ---------------------------------------------------------------------------

// A key is any sequence of non-newline chars that does not start with
// an operator symbol and is followed by ": " or ":\n" or ":<EOI>"
//
// The leading !(":" | "-" | "#") lookahead is load-bearing, not cosmetic:
// without it, mapping_entry can match a sequence_item's text whenever that
// text contains an embedded "word: " substring (e.g. a list item reading
// "- Note: see the appendix"), since key_body would otherwise happily
// consume the leading "- " as part of the key. Because `statement` tries
// mapping_entry before sequence_item, that match would win, then get
// rejected by the "key must not start with an operator" check downstream
// in parser.rs -- a hard parse failure instead of correctly falling back to
// sequence_item. Rejecting it here lets pest try sequence_item next.
key_char  = _{ !(":" ~ (SP | NEWLINE | EOI)) ~ not_nl }
key_body  = { !(":" | "-" | "#") ~ key_char+ }

// ---------------------------------------------------------------------------
// Scalars (plain and double-quoted)
// ---------------------------------------------------------------------------

dq_escape    = _{ "\\" ~ ANY }
dq_inner     = _{ dq_escape | (!("\"" | NEWLINE) ~ ANY) }
dq_scalar    = ${ "\"" ~ dq_inner* ~ "\"" }

// Plain scalar: everything up to an optional inline comment or newline.
// The spacing rule means `#` is only structural when preceded by a space.
plain_char   = _{
    // hash preceded by space → structural (stop before it)
    !(SP ~ "#" ~ (SP | NEWLINE | EOI)) ~
    not_nl
}
plain_scalar = ${ plain_char+ }

scalar_value = { dq_scalar | plain_scalar }

// ---------------------------------------------------------------------------
// Inline comment  (trailing on the same line as a key/value)
// ---------------------------------------------------------------------------

inline_comment_text = { not_nl* }
// `SP+`, not `SP`: writers align trailing comments into a column, so several
// spaces before the `#` is ordinary. A plain scalar stops just before the `#`
// and leaves exactly one space behind, but a quoted scalar ends at its closing
// quote and leaves all of them.
trailing_comment    = { SP+ ~ "#" ~ (SP ~ inline_comment_text | &(NEWLINE | EOI)) }

// ---------------------------------------------------------------------------
// Comment line
// ---------------------------------------------------------------------------

comment_text = { not_nl* }
// A full-line comment: indent, then "# " or "#\n"
comment = { indent ~ "#" ~ (SP ~ comment_text | &(NEWLINE | EOI)) ~ (NEWLINE | EOI) }

// ---------------------------------------------------------------------------
// Literal block  [[[  …  ]]]
// ---------------------------------------------------------------------------

literal_open    = _{ "[[[" ~ NEWLINE }
// The close delimiter may be indented to match the current nesting level
// (spec/02-grammar.md: "at the current indent level for nested use").
literal_close   = _{ " "* ~ "]]]" }
// raw line: any full line that is not itself a close-delimiter line
literal_raw_line = { !literal_close ~ not_nl* ~ NEWLINE }
literal_content  = { literal_raw_line* }
// Note: literal_node does NOT consume its own trailing NEWLINE/EOI — callers
// (the top-level `statement` list, or `mapping_entry`/`sequence_item` via
// `inline_value`) are responsible for that, since consuming it here would
// double up with their own trailing NEWLINE/EOI when used as an inline value.
literal_node    = { literal_open ~ literal_content ~ literal_close }

// ---------------------------------------------------------------------------
// Document fence (Block 2) — triple-backtick, column 0 only
// ---------------------------------------------------------------------------

path_char    = _{ !("." | NEWLINE) ~ ANY }
format_char  = _{ !(NEWLINE) ~ ANY }
fence_path   = { path_char* }
fence_format = { format_char+ }
fence_open  = { "```" ~ fence_path ~ "." ~ fence_format ~ NEWLINE }
fence_close = { "```" ~ (NEWLINE | EOI) }

// ---------------------------------------------------------------------------
// Values (recursive)
// ---------------------------------------------------------------------------

// A value on the same line as a key or list-item marker.
// It can be a literal block, a nested block (mapping/sequence started on
// next line — represented here as empty), or a scalar.
inline_value = { literal_node | scalar_value }

// ---------------------------------------------------------------------------
// Key-value entry
// ---------------------------------------------------------------------------

colon_operator = _{ ":" ~ (SP | &NEWLINE | &EOI) }

mapping_entry = {
    indent ~ key_body ~ colon_operator ~
    (inline_value ~ trailing_comment? | trailing_comment | &(NEWLINE | EOI)) ~
    (NEWLINE | EOI)
}

// ---------------------------------------------------------------------------
// Sequence item
// ---------------------------------------------------------------------------

dash_operator = _{ "-" ~ (SP | &NEWLINE | &EOI) }

sequence_item = {
    indent ~ dash_operator ~
    (inline_value ~ trailing_comment? | trailing_comment | &(NEWLINE | EOI)) ~
    (NEWLINE | EOI)
}

// ---------------------------------------------------------------------------
// Block: a mapping, sequence, or scalar block
// ---------------------------------------------------------------------------

// A line matching no structural rule. It is the *last* alternative, so it
// only ever fires where every other rule has failed.
//
// This exists for block scalar bodies. `|` introduces a block whose content
// lines are verbatim and deliberately not SYON -- `echo one` is neither a
// mapping entry nor a sequence item. A PEG has no indentation context, so it
// cannot tell such a line from a malformed one; that decision needs the
// enclosing block's indent, which only the Builder knows. Tokenising the line
// here and letting the Builder claim it (or reject it as stray) puts the
// decision where the context is.
raw_line = { indent ~ not_nl+ ~ (NEWLINE | EOI) }

statement = _{
    blank_line
  | comment
  | mapping_entry
  | sequence_item
  | (literal_node ~ (NEWLINE | EOI))
  | fence_open
  | fence_close
  | raw_line
}

// ---------------------------------------------------------------------------
// Top-level document
// ---------------------------------------------------------------------------

document = { SOI ~ statement* ~ EOI }
